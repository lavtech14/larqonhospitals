model BillingInvoice {
  id                 String               @id @default(uuid()) @db.Uuid
  patientId          String               @db.Uuid
  patientName        String               @db.VarChar(100)
  patientMrn         String               @db.VarChar(30)
  invoiceNumber      String?              @unique @db.VarChar(40)
  status             BillingInvoiceStatus @default(DRAFT)
  currency           String               @default("INR") @db.Char(3)
  totalMinor         BigInt
  version            Int                  @default(1)
  notes              String?              @db.VarChar(1000)
  cancellationReason String?              @db.VarChar(1000)
  createdByStaffId   String               @db.Uuid
  issuedByStaffId    String?              @db.Uuid
  cancelledByStaffId String?              @db.Uuid
  createdAt          DateTime             @default(now()) @db.Timestamptz(3)
  issuedAt           DateTime?            @db.Timestamptz(3)
  cancelledAt        DateTime?            @db.Timestamptz(3)
  patient            Patient              @relation(fields: [patientId], references: [id], onDelete: Restrict)
  createdBy          StaffUser            @relation("BillingCreator", fields: [createdByStaffId], references: [id], onDelete: Restrict)
  issuedBy           StaffUser?           @relation("BillingIssuer", fields: [issuedByStaffId], references: [id], onDelete: Restrict)
  cancelledBy        StaffUser?           @relation("BillingCanceller", fields: [cancelledByStaffId], references: [id], onDelete: Restrict)
  lines              BillingInvoiceLine[]
  payments           BillingPayment[]

  @@index([patientId, createdAt])
  @@index([status, createdAt])
