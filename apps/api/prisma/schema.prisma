  description    String                @db.VarChar(500)
  quantity       String                @db.VarChar(40)
  quantityUnit   String                @db.VarChar(50)
  unitPriceMinor BigInt
  amountMinor    BigInt
  priceId        String                @db.Uuid
  priceVersion   Int
  invoice        BillingInvoice        @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  appointment    Appointment?          @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  labOrderItem   LabOrderItem?         @relation(fields: [labOrderItemId], references: [id], onDelete: Restrict)
  dispenseItem   PharmacyDispenseItem? @relation(fields: [dispenseItemId], references: [id], onDelete: Restrict)

