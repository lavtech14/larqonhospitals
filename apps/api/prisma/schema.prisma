generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

model Patient {
  billingInvoices BillingInvoice[]
  id              String           @id @default(uuid()) @db.Uuid
  fullName        String           @db.VarChar(100)
  phone           String?          @db.VarChar(20)

  addressLine1 String? @db.VarChar(200)
  addressLine2 String? @db.VarChar(200)
  city         String? @db.VarChar(100)
  district     String? @db.VarChar(100)
  state        String? @db.VarChar(100)
  postalCode   String? @db.VarChar(20)
  countryCode  String? @db.Char(2)

  createdAt            DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                     @updatedAt @db.Timestamptz(3)
  version              Int                          @default(1)
  registrationRequests PatientRegistrationRequest[]
  appointments         Appointment[]
  account              PatientAccount?
  mrn                  String                       @unique @default(dbgenerated("larqon_next_patient_mrn()")) @db.VarChar(30)
  dateOfBirth          DateTime?                    @db.Date
  administrativeSex    AdministrativeSex            @default(UNKNOWN)
  phoneOwner           PatientPhoneOwner            @default(UNKNOWN)
  phoneContactName     String?                      @db.VarChar(100)
  contactEmail         String?                      @db.VarChar(254)

  guardianName         String? @db.VarChar(100)
  guardianRelationship String? @db.VarChar(50)
  guardianPhone        String? @db.VarChar(20)

  emergencyContactName         String?         @db.VarChar(100)
  emergencyContactRelationship String?         @db.VarChar(50)
  emergencyContactPhone        String?         @db.VarChar(20)
  rpmEnrollments               RpmEnrollment[]
  rpmAssignments               RpmAssignment[]

  @@index([fullName])
  @@index([phone])
}

enum StaffRole {
  ADMIN
  RECEPTIONIST
  DOCTOR
  NURSE
  LAB_TECHNICIAN
  LAB_REVIEWER
  PHARMACIST
  BILLING
}

model StaffUser {
  createdBillingInvoices   BillingInvoice[]   @relation("BillingCreator")
  issuedBillingInvoices    BillingInvoice[]   @relation("BillingIssuer")
  cancelledBillingInvoices BillingInvoice[]   @relation("BillingCanceller")
  billingPayments          BillingPayment[]   @relation("BillingPaymentReceiver")
  billingPrices            BillingPrice[]     @relation("BillingPriceEditor")
  billingRequests          BillingRequest[]
  receivedPharmacyStock    PharmacyStockLot[] @relation("PharmacyStockReceiver")
  pharmacyDispenses        PharmacyDispense[] @relation("PharmacyDispenser")
  id                       String             @id @default(uuid()) @db.Uuid
  email                    String             @unique @db.VarChar(254)
  fullName                 String             @db.VarChar(100)
  addressLine1             String?            @db.VarChar(200)
  addressLine2             String?            @db.VarChar(200)
  city                     String?            @db.VarChar(100)
  district                 String?            @db.VarChar(100)
  state                    String?            @db.VarChar(100)
  postalCode               String?            @db.VarChar(20)
  countryCode              String?            @db.Char(2)
  passwordHash             String
  isActive                 Boolean            @default(true)
  mustChangePassword       Boolean            @default(true)
  passwordChangedAt        DateTime?          @db.Timestamptz(3)
  createdAt                DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime           @updatedAt @db.Timestamptz(3)

  roles                   StaffUserRole[]
  sessions                StaffSession[]
  auditEvents             AuditEvent[]
  registrationRequests    PatientRegistrationRequest[]
  doctorProfile           DoctorProfile?
  createdAppointments     Appointment[]                @relation("AppointmentCreator")
  cancelledAppointments   Appointment[]                @relation("AppointmentCanceller")
  bookingRequests         AppointmentBookingRequest[]
  createdPatientAccounts  PatientAccount[]
  checkedInEncounters     Encounter[]                  @relation("EncounterCheckInStaff")
  recordedVitals          VitalObservation[]           @relation("VitalRecorder")
  clinicalNoteRevisions   ClinicalNoteRevision[]       @relation("ClinicalNoteAuthor")
  authoredPrescriptions   Prescription[]               @relation("PrescriptionAuthor")
  prescriptionRequests    PrescriptionRequest[]        @relation("PrescriptionRequestActor")
  publishedVisitSummaries PublishedVisitSummary[]      @relation("VisitSummaryPublisher")
  createdLabOrders        LabOrder[]                   @relation("LabOrderCreator")
  collectedLabSamples     LabSample[]                  @relation("LabSampleCollector")
  labResultRevisions      LabResultRevision[]          @relation("LabResultAuthor")
  releasedLabReports      LabReleasedReport[]          @relation("LabReportReviewer")
  labSampleRejections     LabSampleRejection[]         @relation("LabSampleRejector")
  cancelledLabOrders      LabOrder[]                   @relation("LabOrderCanceller")
  labOrderCancellations   LabOrderCancellation[]       @relation("LabOrderCancellationActor")
  createdRpmEnrollments   RpmEnrollment[]              @relation("RpmEnrollmentCreator")
  rpmTeamMemberships      RpmCareTeamMember[]
  approvedRpmPlans        RpmPlanVersion[]             @relation("RpmPlanApprover")
  rpmReviews              RpmReview[]
  rpmObservationReviews   RpmObservationReview[]
  assignedHomeMonitoring  RpmAssignment[]              @relation("RpmAssignmentAuthor")
  nursingHomeMonitoring   RpmAssignment[]              @relation("RpmAssignmentNurse")
}

model StaffUserRole {
  staffUserId String    @db.Uuid
  role        StaffRole
  assignedAt  DateTime  @default(now()) @db.Timestamptz(3)

  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Restrict)

  @@id([staffUserId, role])
}

model StaffSession {
  id          String    @id @default(uuid()) @db.Uuid
  staffUserId String    @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime  @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)

  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Restrict)

  refreshTokens StaffRefreshToken[]

  @@index([staffUserId])
  @@index([expiresAt])
}

model StaffRefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  sessionId String    @db.Uuid
  tokenHash String    @unique @db.VarChar(64)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)

  session StaffSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([expiresAt])
}

model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  actorStaffId String   @db.Uuid
  action       String   @db.VarChar(100)
  resourceType String   @db.VarChar(50)
  resourceId   String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  actor StaffUser @relation(fields: [actorStaffId], references: [id], onDelete: Restrict)

  @@index([actorStaffId, createdAt])
  @@index([resourceType, resourceId])
}

model PatientRegistrationRequest {
  actorStaffId String   @db.Uuid
  key          String   @db.Uuid
  requestHash  String   @db.VarChar(64)
  patientId    String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  actor   StaffUser @relation(fields: [actorStaffId], references: [id], onDelete: Restrict)
  patient Patient   @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@id([actorStaffId, key])
  @@index([patientId])
}

model Department {
  id        String          @id @default(uuid()) @db.Uuid
  code      String          @unique @db.VarChar(20)
  name      String          @db.VarChar(100)
  isActive  Boolean         @default(true)
  version   Int             @default(1)
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @db.Timestamptz(3)
  doctors   DoctorProfile[]
}

model DoctorProfile {
  billingPrices         BillingPrice[]
  id                    String         @id @default(uuid()) @db.Uuid
  displayName           String         @db.VarChar(100)
  specialty             String         @db.VarChar(100)
  qualification         String?        @db.VarChar(200)
  registrationNumber    String?        @db.VarChar(100)
  registrationAuthority String?        @db.VarChar(100)

  departmentId String  @db.Uuid
  staffUserId  String? @unique @db.Uuid

  isActive  Boolean  @default(true)
  version   Int      @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  department     Department          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  staffUser      StaffUser?          @relation(fields: [staffUserId], references: [id], onDelete: Restrict)
  availability   DoctorAvailability?
  dateClosures   DoctorDateClosure[]
  appointments   Appointment[]
  rpmEnrollments RpmEnrollment[]
  rpmAssignments RpmAssignment[]

  @@index([departmentId, isActive])
}

model DoctorAvailability {
  doctorId  String   @id @db.Uuid
  timeZone  String   @default("Asia/Kolkata") @db.VarChar(50)
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  doctor  DoctorProfile              @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  windows DoctorAvailabilityWindow[]
}

model DoctorAvailabilityWindow {
  id          String @id @default(uuid()) @db.Uuid
  doctorId    String @db.Uuid
  dayOfWeek   Int
  startMinute Int
  endMinute   Int
  slotMinutes Int

  availability DoctorAvailability        @relation(fields: [doctorId], references: [doctorId], onDelete: Cascade)
  breaks       DoctorAvailabilityBreak[]

  @@index([doctorId, dayOfWeek, startMinute])
}

model DoctorAvailabilityBreak {
  id          String @id @default(uuid()) @db.Uuid
  windowId    String @db.Uuid
  startMinute Int
  endMinute   Int

  window DoctorAvailabilityWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)

  @@index([windowId])
}

model DoctorDateClosure {
  id        String   @id @default(uuid()) @db.Uuid
  doctorId  String   @db.Uuid
  date      DateTime @db.Date
  isClosed  Boolean  @default(true)
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  doctor DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  @@unique([doctorId, date])
}

model HospitalDateClosure {
  id        String   @id @default(uuid()) @db.Uuid
  date      DateTime @unique @db.Date
  isClosed  Boolean  @default(true)
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

enum AppointmentStatus {
  BOOKED
  CANCELLED
}

model Appointment {
  billingLines     BillingInvoiceLine[]
  id               String               @id @default(uuid()) @db.Uuid
  patientId        String               @db.Uuid
  doctorId         String               @db.Uuid
  createdByStaffId String               @db.Uuid
  startsAt         DateTime             @db.Timestamptz(3)
  endsAt           DateTime             @db.Timestamptz(3)
  status           AppointmentStatus    @default(BOOKED)
  version          Int                  @default(1)
  createdAt        DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @db.Timestamptz(3)

  cancelledAt        DateTime? @db.Timestamptz(3)
  cancelledByStaffId String?   @db.Uuid

  patient     Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor      DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  createdBy   StaffUser     @relation("AppointmentCreator", fields: [createdByStaffId], references: [id], onDelete: Restrict)
  cancelledBy StaffUser?    @relation("AppointmentCanceller", fields: [cancelledByStaffId], references: [id], onDelete: Restrict)

  bookingRequests          AppointmentBookingRequest[]
  mode                     AppointmentMode             @default(IN_PERSON)
  consultationEndedAt      DateTime?                   @db.Timestamptz(3)
  consultationRoomClosedAt DateTime?                   @db.Timestamptz(3)
  encounter                Encounter?

  @@index([doctorId, startsAt])
  @@index([patientId, startsAt])
  @@index([status, startsAt])
}

model AppointmentBookingRequest {
  actorStaffId  String   @db.Uuid
  key           String   @db.Uuid
  requestHash   String   @db.VarChar(64)
  appointmentId String   @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  actor       StaffUser   @relation(fields: [actorStaffId], references: [id], onDelete: Restrict)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  @@id([actorStaffId, key])
  @@index([appointmentId])
}

enum AppointmentMode {
  IN_PERSON
  ONLINE
}

model PatientAccount {
  id                 String    @id @default(uuid()) @db.Uuid
  patientId          String    @unique @db.Uuid
  email              String    @unique @db.VarChar(254)
  passwordHash       String
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  passwordChangedAt  DateTime? @db.Timestamptz(3)
  createdByStaffId   String    @db.Uuid
  version            Int       @default(1)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  patient                Patient          @relation(fields: [patientId], references: [id], onDelete: Restrict)
  createdBy              StaffUser        @relation(fields: [createdByStaffId], references: [id], onDelete: Restrict)
  sessions               PatientSession[]
  rpmSubmissions         RpmSubmission[]
  homeMonitoringReadings RpmReading[]
}

model PatientSession {
  id               String    @id @default(uuid()) @db.Uuid
  patientAccountId String    @db.Uuid
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt        DateTime  @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)

  account       PatientAccount        @relation(fields: [patientAccountId], references: [id], onDelete: Restrict)
  refreshTokens PatientRefreshToken[]

  @@index([patientAccountId])
  @@index([expiresAt])
}

model PatientRefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  sessionId String    @db.Uuid
  tokenHash String    @unique @db.VarChar(64)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)

  session PatientSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([expiresAt])
}

enum AdministrativeSex {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum PatientPhoneOwner {
  PATIENT
  GUARDIAN
  OTHER
  UNKNOWN
}

enum EncounterStatus {
  CHECKED_IN
  READY_FOR_DOCTOR
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Encounter {
  id                 String          @id @default(uuid()) @db.Uuid
  appointmentId      String          @unique @db.Uuid
  status             EncounterStatus @default(CHECKED_IN)
  checkedInAt        DateTime        @default(now()) @db.Timestamptz(3)
  checkedInByStaffId String          @db.Uuid
  readyForDoctorAt   DateTime?       @db.Timestamptz(3)
  startedAt          DateTime?       @db.Timestamptz(3)
  completedAt        DateTime?       @db.Timestamptz(3)
  cancelledAt        DateTime?       @db.Timestamptz(3)
  version            Int             @default(1)
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(3)

  appointment      Appointment            @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  checkedInBy      StaffUser              @relation("EncounterCheckInStaff", fields: [checkedInByStaffId], references: [id], onDelete: Restrict)
  vitals           VitalObservation[]
  noteRevisions    ClinicalNoteRevision[]
  prescriptions    Prescription[]
  publishedSummary PublishedVisitSummary?
  labOrders        LabOrder[]

  @@index([status, checkedInAt])
  @@index([checkedInByStaffId])
}

model VitalObservation {
  id          String @id @default(uuid()) @db.Uuid
  encounterId String @db.Uuid

  temperatureC     Decimal? @db.Decimal(5, 2)
  pulseBpm         Int?
  respiratoryRate  Int?
  systolicBp       Int?
  diastolicBp      Int?
  oxygenSaturation Decimal? @db.Decimal(5, 2)
  weightKg         Decimal? @db.Decimal(6, 2)
  heightCm         Decimal? @db.Decimal(6, 2)

  measuredAt        DateTime @db.Timestamptz(3)
  recordedAt        DateTime @default(now()) @db.Timestamptz(3)
  recordedByStaffId String   @db.Uuid

  notes String? @db.VarChar(1000)

  idempotencyKey String @db.Uuid
  requestHash    String @db.VarChar(64)

  encounter  Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  recordedBy StaffUser @relation("VitalRecorder", fields: [recordedByStaffId], references: [id], onDelete: Restrict)

  @@unique([recordedByStaffId, idempotencyKey])
  @@index([encounterId, measuredAt, id])
  @@index([recordedByStaffId, recordedAt])
}

model ClinicalNoteRevision {
  id            String @id @default(uuid()) @db.Uuid
  encounterId   String @db.Uuid
  authorStaffId String @db.Uuid
  revision      Int

  complaint   String @db.VarChar(5000)
  history     String @db.VarChar(5000)
  examination String @db.VarChar(5000)
  assessment  String @db.VarChar(5000)
  plan        String @db.VarChar(5000)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  idempotencyKey String @db.Uuid
  requestHash    String @db.VarChar(64)

  encounter          Encounter               @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  author             StaffUser               @relation("ClinicalNoteAuthor", fields: [authorStaffId], references: [id], onDelete: Restrict)
  publishedSummaries PublishedVisitSummary[]

  @@unique([encounterId, revision])
  @@unique([authorStaffId, idempotencyKey])
}

enum PrescriptionStatus {
  DRAFT
  ISSUED
  CANCELLED
  REPLACED
}

enum AllergyReviewStatus {
  NOT_REVIEWED
  NO_KNOWN_ALLERGIES
  ALLERGIES_REPORTED
  UNKNOWN
}

enum PrescriptionOperation {
  CREATE_DRAFT
  SAVE_DRAFT
  ISSUE
  CANCEL
}

model Medicine {
  billingPrices BillingPrice[]
  id            String         @id @default(uuid()) @db.Uuid
  code          String         @unique @db.VarChar(40)
  displayName   String         @db.VarChar(200)
  genericName   String?        @db.VarChar(200)
  strength      String         @db.VarChar(100)
  dosageForm    String         @db.VarChar(100)

  isActive Boolean @default(true)
  version  Int     @default(1)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  pharmacyStockLots PharmacyStockLot[]
  prescriptionItems PrescriptionItem[]

  @@index([displayName])
  @@index([isActive, displayName])
}

model Prescription {
  pharmacyDispenses PharmacyDispense[]
  id                String             @id @default(uuid()) @db.Uuid
  encounterId       String             @db.Uuid
  authorStaffId     String             @db.Uuid

  status  PrescriptionStatus @default(DRAFT)
  version Int                @default(1)

  allergyStatus  AllergyReviewStatus @default(NOT_REVIEWED)
  allergyDetails String?             @db.VarChar(2000)
  instructions   String?             @db.VarChar(2000)

  // Identity snapshots populated when the prescription is issued.
  patientName                     String? @db.VarChar(100)
  patientMrn                      String? @db.VarChar(30)
  prescriberName                  String? @db.VarChar(100)
  prescriberRegistrationNumber    String? @db.VarChar(100)
  prescriberRegistrationAuthority String? @db.VarChar(100)

  issuedAt           DateTime? @db.Timestamptz(3)
  cancelledAt        DateTime? @db.Timestamptz(3)
  cancellationReason String?   @db.VarChar(1000)

  replacesPrescriptionId String? @unique @db.Uuid
  replacementReason      String? @db.VarChar(1000)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  author    StaffUser @relation("PrescriptionAuthor", fields: [authorStaffId], references: [id], onDelete: Restrict)

  replaces    Prescription? @relation("PrescriptionReplacement", fields: [replacesPrescriptionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  replacement Prescription? @relation("PrescriptionReplacement")

  items    PrescriptionItem[]
  requests PrescriptionRequest[]

  @@index([encounterId, createdAt])
  @@index([authorStaffId, createdAt])
  @@index([status, issuedAt])
}

model PrescriptionItem {
  pharmacyDispenseItems PharmacyDispenseItem[]
  id                    String                 @id @default(uuid()) @db.Uuid
  prescriptionId        String                 @db.Uuid
  medicineId            String                 @db.Uuid
  position              Int

  // Copied from the selected catalogue entry.
  medicineName String  @db.VarChar(200)
  genericName  String? @db.VarChar(200)
  strength     String  @db.VarChar(100)
  dosageForm   String  @db.VarChar(100)

  // Entered explicitly by the prescribing doctor.
  dose         String  @db.VarChar(200)
  route        String  @db.VarChar(100)
  frequency    String  @db.VarChar(200)
  duration     String  @db.VarChar(200)
  quantity     Decimal @db.Decimal(10, 2)
  quantityUnit String  @db.VarChar(50)

  instructions String? @db.VarChar(1000)

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Restrict)
  medicine     Medicine     @relation(fields: [medicineId], references: [id], onDelete: Restrict)

  @@unique([prescriptionId, position])
  @@index([medicineId])
}

model PrescriptionRequest {
  actorStaffId String @db.Uuid
  key          String @db.Uuid

  operation      PrescriptionOperation
  requestHash    String                @db.VarChar(64)
  prescriptionId String                @db.Uuid
  resultVersion  Int

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  actor        StaffUser    @relation("PrescriptionRequestActor", fields: [actorStaffId], references: [id], onDelete: Restrict)
  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Restrict)

  @@id([actorStaffId, key])
  @@index([prescriptionId])
}

model PublishedVisitSummary {
  id String @id @default(uuid()) @db.Uuid

  encounterId          String @unique @db.Uuid
  sourceNoteRevisionId String @db.Uuid
  publishedByStaffId   String @db.Uuid

  patientName String @db.VarChar(100)
  patientMrn  String @db.VarChar(30)

  doctorName                  String  @db.VarChar(100)
  doctorRegistrationNumber    String? @db.VarChar(100)
  doctorRegistrationAuthority String? @db.VarChar(100)

  summary           String @db.VarChar(5000)
  carePlan          String @db.VarChar(5000)
  followUp          String @db.VarChar(2000)
  returnPrecautions String @db.VarChar(2000)

  publishedAt DateTime @default(now()) @db.Timestamptz(3)

  idempotencyKey String @db.Uuid
  requestHash    String @db.VarChar(64)

  encounter          Encounter            @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  sourceNoteRevision ClinicalNoteRevision @relation(fields: [sourceNoteRevisionId], references: [id], onDelete: Restrict)
  publishedBy        StaffUser            @relation("VisitSummaryPublisher", fields: [publishedByStaffId], references: [id], onDelete: Restrict)

  @@unique([publishedByStaffId, idempotencyKey])
  @@index([sourceNoteRevisionId])
}

model LabTest {
  billingPrices BillingPrice[]
  id            String         @id @default(uuid()) @db.Uuid

  code        String @unique @db.VarChar(40)
  displayName String @db.VarChar(200)

  sampleType              String  @db.VarChar(100)
  preparationInstructions String? @db.VarChar(2000)

  isActive Boolean @default(true)
  version  Int     @default(1)

  createdAt  DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @db.Timestamptz(3)
  orderItems LabOrderItem[]
  parameters Json           @default("[]")

  @@index([displayName])
  @@index([isActive, displayName])
}

enum LabOrderPriority {
  ROUTINE
  URGENT
}

model LabOrder {
  id String @id @default(uuid()) @db.Uuid

  encounterId      String @db.Uuid
  orderedByStaffId String @db.Uuid

  priority LabOrderPriority @default(ROUTINE)
  status   LabOrderStatus   @default(ORDERED)

  clinicalReason String @db.VarChar(2000)

  patientName String @db.VarChar(100)
  patientMrn  String @db.VarChar(30)
  doctorName  String @db.VarChar(100)

  version   Int      @default(1)
  orderedAt DateTime @default(now()) @db.Timestamptz(3)

  idempotencyKey String @db.Uuid
  requestHash    String @db.VarChar(64)

