enum BillingKind {
  CONSULTATION
  LAB
  MEDICINE
}

enum BillingInvoiceStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum BillingPaymentMethod {
  CASH
  UPI
  CARD
}

model BillingPrice {
  lines           BillingInvoiceLine[]
  id              String               @id @default(uuid()) @db.Uuid
  catalogueKey    String               @unique @db.VarChar(150)
  kind            BillingKind
  doctorId        String?              @db.Uuid
  labTestId       String?              @db.Uuid
  medicineId      String?              @db.Uuid
  displayName     String               @db.VarChar(500)
  quantityUnit    String               @db.VarChar(50)
  unitPriceMinor  BigInt
  isActive        Boolean              @default(true)
  version         Int                  @default(1)
  editedByStaffId String               @db.Uuid
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(3)
  doctor          DoctorProfile?       @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  labTest         LabTest?             @relation(fields: [labTestId], references: [id], onDelete: Restrict)
  medicine        Medicine?            @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  editedBy        StaffUser            @relation("BillingPriceEditor", fields: [editedByStaffId], references: [id], onDelete: Restrict)

  @@index([kind, isActive, displayName])
